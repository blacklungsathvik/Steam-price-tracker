# --- storage ---
DB_PATH=data/tracker.db

# --- regions to track (Steam country codes) ---
# Set to 'all' to track all 42 official Steam regions and currencies worldwide,
# or provide a comma-separated list (e.g. us,gb,eu,in,jp,kr,cn,br,ca,au)
TRACK_REGIONS=all

# --- Steam Web API key ---
# Optional: Used to automatically synchronize the complete master catalog of all games on Steam.
# Get a free key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- politeness toward Steam: minimum seconds between outbound requests ---
STEAM_REQUEST_DELAY=1.6

# --- optional: backfill years of price history from IsThereAnyDeal (free key: isthereanydeal.com/apps) ---
ITAD_API_KEY=

# --- web ---
# Number of reverse proxies in front of gunicorn (so rate limiting sees real client IPs)
TRUST_PROXY=1
# Allow the web process to fetch an unknown game live when a visitor opens or searches for it
LIVE_FETCH=1
LIVE_RATE_PER_MIN=20
# Protects POST /api/admin/* endpoints. Leave empty to disable them.
ADMIN_TOKEN=

# --- collector ---
COLLECTOR_INTERVAL_SECONDS=10800
DETAILS_PER_CYCLE=60
# Optional JSON overrides for minor-unit divisors (defaults to 100 for all Steam currencies)
CURRENCY_DIVISORS={}
