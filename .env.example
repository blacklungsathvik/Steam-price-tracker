# --- storage ---
DB_PATH=data/tracker.db
# --- regions to track (Steam country codes). First one is the default. ---
TRACK_REGIONS=us,gb,eu,in,au,ca,br,ru,de,fr,jp,kr,sg,tr
# --- politeness toward Steam: minimum seconds between outbound requests ---
STEAM_REQUEST_DELAY=1.6
# --- optional: backfill years of price history from IsThereAnyDeal (free key: isthereanydeal.com/apps) ---
ITAD_API_KEY=
# --- web ---
# Number of reverse proxies in front of gunicorn (so rate limiting sees real client IPs)
TRUST_PROXY=1
# Allow the web process to fetch an unknown game live when a visitor opens it
LIVE_FETCH=1
LIVE_RATE_PER_MIN=20
# Protects POST /api/admin/* endpoints. Leave empty to disable them.
ADMIN_TOKEN=
# --- collector ---
COLLECTOR_INTERVAL_SECONDS=10800
DETAILS_PER_CYCLE=60
# Optional JSON overrides for minor-unit divisors, e.g. {"JPY":1}
CURRENCY_DIVISORS={}
